# This key is exposed to browser code. Use a restricted Last.fm API key.
PUBLIC_LAST_FM_API_KEY=

# Required when running or building with TinaCMS.
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Optional TinaCMS branch override. Defaults to main.
GITHUB_BRANCH=main

# Base64-encoded Google service-account JSON. Share both CV Docs with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Make a missing or failed CV export stop the build.
REQUIRE_RESUME_EXPORT=false
