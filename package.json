{
	"name": "joaodias.me",
	"version": "6.0.0",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"private": false,
	"scripts": {
		"dev": "tinacms dev -c \"pnpm start\"",
		"start": "pnpm generate-build-info && pnpm generate-llms-txt && astro dev",
		"build:ci": "tinacms build && pnpm build",
		"build": "pnpm export-resumes && pnpm generate-build-info && pnpm generate-llms-txt && astro build",
		"preview": "astro preview",
		"serve": "pnpm build && pnpm preview",
		"test": "pnpm test:unit && pnpm test:headless",
		"test:unit": "vitest run",
		"test:ui": "playwright test --ui",
		"test:headless": "playwright test",
		"test:open": "pnpm test:ui",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"format:check": "biome format ./src",
		"typecheck": "astro sync && tsc --noEmit --skipLibCheck --project tsconfig.json",
		"generate-build-info": "node ./scripts/get-build-info.mjs",
		"export-resumes": "node ./scripts/export-resumes.mjs",
		"generate-llms-txt": "tsx ./scripts/generate-llms-txt.ts",
		"get-latest-shows": "tsx ./scripts/get-latest-shows.ts",
		"prepare": "husky",
		"check:staged": "lint-staged"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,astro,json,css,md}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@astrojs/react": "6.0.1",
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.4",
		"@jtmdias/js-utilities": "^3.1.0",
		"@jtmdias/react-a11y-tools": "3.1.1",
		"@playwright/test": "^1.61.1",
		"@tanstack/react-virtual": "^3.14.6",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/colorthief": "^2.6.1",
		"@types/node": "^26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"astro": "^7.1.0",
		"autoprefixer": "^10.5.4",
		"axe-core": "4.12.1",
		"colorthief": "^3.4.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"playwright": "^1.62.1",
		"postcss-custom-media": "^12.0.1",
		"react": "19.2.8",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"sass": "1.102.0",
		"sharp": "^0.35.3",
		"start-server-and-test": "^3.0.11",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tanstack/react-query": "^5.101.4",
		"@tinacms/cli": "^2.5.6",
		"clsx": "^2.1.1",
		"lit": "^3.3.3",
		"media-chrome": "^4.19.2",
		"tinacms": "^3.11.0"
	}
}
