{
  "name": "joaodias.me",
  "version": "5.5",
  "private": false,
  "scripts": {
    "dev": "tinacms dev -c \"npm run start\"",
    "start": "npm run generate-build-info && astro dev",
    "build:ci": "tinacms build && npm run build",
    "build": "npm run generate-build-info && astro build",
    "preview": "astro preview",
    "test": "npm run test:headless",
    "test:ui": "playwright test --ui",
    "test:headless": "playwright test",
    "test:open": "npm run test:ui",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.json",
    "generate-build-info": "node get-build-info.mjs"
  },
  "devDependencies": {
    "@astrojs/react": "4.4.2",
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "2.3.11",
    "@jtmdias/js-utilities": "^3.0.0",
    "@jtmdias/react-a11y-tools": "3.0.0",
    "@playwright/test": "^1.57.0",
    "@tanstack/react-virtual": "^3.13.16",
    "@types/node": "^24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "astro": "^5.16.6",
    "autoprefixer": "^10.4.23",
    "axe-core": "4.11.0",
    "postcss-custom-media": "^11.0.6",
    "react": "19.2.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "sass": "1.97.1",
    "start-server-and-test": "^2.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.6.0",
    "@tinacms/cli": "^2.0.6",
    "media-chrome": "^4.17.2",
    "tinacms": "^3.1.3"
  }
}
