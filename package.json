{
  "name": "joaodias.me",
  "version": "5.5",
  "private": false,
  "scripts": {
    "dev": "tinacms dev -c \"pnpm start\"",
    "start": "pnpm generate-build-info && pnpm generate-llms-txt && astro dev",
    "build:ci": "tinacms build && pnpm build",
    "build": "pnpm generate-build-info && pnpm generate-llms-txt && astro build",
    "preview": "astro preview",
    "test": "pnpm test:headless",
    "test:ui": "playwright test --ui",
    "test:headless": "playwright test",
    "test:open": "pnpm test:ui",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.json",
    "generate-build-info": "node ./scripts/get-build-info.mjs",
    "generate-llms-txt": "tsx ./scripts/generate-llms-txt.ts",
    "get-latest-shows": "tsx ./scripts/get-latest-shows.ts"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.4",
    "@jtmdias/js-utilities": "^3.1.0",
    "@jtmdias/react-a11y-tools": "3.1.1",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/colorthief": "^2.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "astro": "^7.1.0",
    "autoprefixer": "^10.5.4",
    "axe-core": "4.12.1",
    "colorthief": "^3.4.0",
    "playwright": "^1.62.1",
    "postcss-custom-media": "^12.0.1",
    "react": "19.2.8",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sass": "1.101.0",
    "sharp": "^0.35.3",
    "start-server-and-test": "^3.0.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tanstack/react-query": "^5.101.4",
    "@tinacms/cli": "^2.5.6",
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "media-chrome": "^4.19.2",
    "tinacms": "^3.11.0"
  }
}
