{
  "name": "joaodias.me",
  "version": "5.5",
  "private": false,
  "scripts": {
    "dev": "tinacms dev -c \"npm run start\"",
    "start": "npm run generate-build-info && astro dev",
    "build:ci": "tinacms build && npm run build",
    "build": "npm run generate-build-info && astro build",
    "preview": "astro preview",
    "test": "npm run test:headless",
    "test:ui": "playwright test --ui",
    "test:headless": "playwright test",
    "test:open": "npm run test:ui",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.json",
    "generate-build-info": "node ./scripts/get-build-info.mjs",
    "get-latest-shows": "tsx ./scripts/get-latest-shows.ts"
  },
  "devDependencies": {
    "@astrojs/react": "5.0.3",
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.4.11",
    "@jtmdias/js-utilities": "^3.0.0",
    "@jtmdias/react-a11y-tools": "3.0.0",
    "@playwright/test": "^1.59.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "^6.1.5",
    "autoprefixer": "^10.4.27",
    "axe-core": "4.11.2",
    "postcss-custom-media": "^11.0.6",
    "react": "19.2.5",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "sass": "1.99.0",
    "start-server-and-test": "^3.0.0",
    "typescript": "^6.0.2",
    "zod": "^4.3.6",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@tinacms/cli": "^2.2.2",
    "media-chrome": "^4.18.3",
    "tinacms": "^3.7.2"
  }
}
