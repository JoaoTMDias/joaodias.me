---
import BaseHead from "../components/layout/BaseHead/BaseHead.astro";
import { getLocale, htmlLang, type Locale } from "../i18n";

export interface Props {
	title: string;
	description: string;
	itemtype?: string;
	lang?: string;
	locale?: Locale;
	alternateUrls?: Partial<Record<Locale, string>>;
}

const {
	title,
	description,
	itemtype = "http://schema.org/WebPage",
	locale = getLocale(Astro.currentLocale),
	lang = htmlLang[locale],
	alternateUrls,
} = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  prefix="http://ogp.me/ns#"
  itemtype={itemtype}
  dir="ltr"
  data-testid="html-element"
>
  <head>
    <BaseHead title={title} description={description} locale={locale} alternateUrls={alternateUrls} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style lang="scss">
  @use "../assets/styles/custom-media.scss";

  .container {
    width: 100%;
    display: grid;
    grid-template-rows: var(--header-height) 1fr auto;
    grid-gap: 3rem;

    @media (--large-viewport) {
      grid-template-rows: auto 1fr auto;
      grid-gap: 0;
    }
  }

  .main-content {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-block: 10vh;
    padding-inline: 1rem;
    margin: 0 auto;
    max-width: 100vw;

    @media (--large-viewport) {
      padding-block: 6rem;
      padding-inline: 3rem;
      max-width: 75rem;
    }
  }
</style>
