---
import Footer from "../components/footer/index.astro";
import Header from "../components/header/index.astro";
import BaseLayout from "./BaseLayout.astro";

export interface Props {
	title: string;
	description: string;
	itemtype?: string;
}

const { title, description, itemtype = "http://schema.org/WebPage" } = Astro.props;
---

<BaseLayout title={title} description={description} itemtype={itemtype}>
  <div class="container">
    <Header />
    <slot />
    <Footer />
  </div>
</BaseLayout>

<style lang="scss">
  @use "../assets/styles/custom-media.scss";

  .footer {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
    width: 100%;
    padding-block-start: 3rem;

    @media (--large-viewport) {
      padding-block-start: 6rem;
    }

    &__bottom {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      gap: 1rem;
    }

    &__others {
      font-family: var(--text-font-family);
      font-size: var(--font-size-base);
      line-height: 1.5;
      color: var(--text-color);
      margin: 0;
    }
  }

  .currently-listening {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 1rem;
    width: 100%;

    &__title {
      font-family: var(--text-font-family);
      font-style: normal;
      font-weight: 500;
      font-size: 0.875rem;
      line-height: 1.0625rem;
      text-transform: uppercase;
      color: var(--text-color);
      max-width: 80rem;
      margin: 0 auto;
      width: 100%;
      padding-inline: 3rem;
      text-align: center;
    }

    &__container {
      display: grid;
      place-items: center;
      background-color: var(--background-color);
      box-shadow:
        0 -1px 0 0 var(--text-color),
        0 1px 0 0 var(--text-color);
      position: relative;

      @media (--large-viewport) {
        height: 5rem;
      }
    }
  }
</style>
