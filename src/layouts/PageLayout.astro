---
import Footer from "../components/layout/Footer/Footer.astro";
import Header from "../components/layout/Header/Header.astro";
import { getLocale, type Locale, localePath } from "../i18n";
import { getMessages } from "../i18n/messages";
import BaseLayout from "./BaseLayout.astro";

export interface Props {
	title: string;
	description: string;
	itemtype?: string;
	locale?: Locale;
	alternateUrls?: Partial<Record<Locale, string>>;
	languageUrl?: string;
}

const {
	title,
	description,
	itemtype = "http://schema.org/WebPage",
	locale = getLocale(Astro.currentLocale),
	alternateUrls,
	languageUrl,
} = Astro.props;
const t = getMessages(locale);
const otherLocale = locale === "en" ? "pt" : "en";
const unprefixedPath = Astro.url.pathname.replace(/^\/pt(?=\/|$)/, "") || "/";
const defaultLanguageUrl = localePath(otherLocale, unprefixedPath);
const effectiveAlternates =
	alternateUrls ??
	(languageUrl
		? undefined
		: { en: localePath("en", unprefixedPath), pt: localePath("pt", unprefixedPath) });
---

<BaseLayout title={title} description={description} itemtype={itemtype} locale={locale} alternateUrls={effectiveAlternates}>
  <div class="container">
    <Header locale={locale} languageUrl={languageUrl ?? defaultLanguageUrl} />
    <main id="content" tabindex={-1} aria-label={t.common.main}>
      <slot />
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>
