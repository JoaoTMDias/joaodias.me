---
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "../components/layout/Footer/Footer.astro";
import Header from "../components/layout/Header/Header.astro";
import { getLocale, type Locale } from "../i18n";
import { getMessages } from "../i18n/messages";
import BaseLayout from "./BaseLayout.astro";

export interface Props {
	title: string;
	description: string;
	locale?: Locale;
	alternateUrls?: Partial<Record<Locale, string>>;
	languageUrl?: string;
	image?: string;
	noindex?: boolean;
	openGraphType?: "article" | "website";
	publishedTime?: string;
	modifiedTime?: string;
	structuredData?: Record<string, unknown>;
}

const {
	title,
	description,
	locale = getLocale(Astro.currentLocale),
	alternateUrls,
	languageUrl,
	image,
	noindex,
	openGraphType,
	publishedTime,
	modifiedTime,
	structuredData,
} = Astro.props;
const t = getMessages(locale);
const otherLocale = locale === "en" ? "pt" : "en";
const unprefixedPath = Astro.url.pathname.replace(/^\/pt(?=\/|$)/, "") || "/";
const localeRoute = unprefixedPath.replace(/^\/+|\/+$/g, "") || undefined;
const defaultLanguageUrl = getRelativeLocaleUrl(otherLocale, localeRoute);
const effectiveAlternates =
	alternateUrls ??
	(languageUrl
		? undefined
		: { en: getRelativeLocaleUrl("en", localeRoute), pt: getRelativeLocaleUrl("pt", localeRoute) });
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternateUrls={effectiveAlternates}
  image={image}
  noindex={noindex}
  openGraphType={openGraphType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
>
  <div class="container">
    <Header locale={locale} languageUrl={languageUrl ?? defaultLanguageUrl} />
    <main id="content" tabindex={-1} aria-label={t.common.main}>
      <slot />
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>
