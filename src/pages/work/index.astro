import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { contentUrl, formatDate, getLocale } from "../../i18n";
import { getMessages } from "../../i18n/messages";
import PageLayout from "../../layouts/PageLayout.astro";
import styles from "./index.module.scss";

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);

// Constants
const DEFAULT_THEME = {
	background: "#000000",
	foreground: "#ffffff",
} as const;

const THUMBNAIL_DIMENSIONS = {
	width: 123,
	height: 123,
} as const;

const DATE_FORMAT_OPTIONS: Intl.DateTimeFormatOptions = {
	year: "numeric",
	month: "long",
};

// Helper functions
function normalizeThumbnailPath(path: string): string {
	return path.startsWith("/") ? path : `/${path}`;
}

function getProjectTheme(project: CollectionEntry<"projects">) {
	return {
		background: project.data.themeBackground || DEFAULT_THEME.background,
		foreground: project.data.themeForeground || DEFAULT_THEME.foreground,
	};
}

function formatProjectDate(date: Date): string {
	return formatDate(date, locale, DATE_FORMAT_OPTIONS);
}

function getTransitionNames(slug: string) {
	return {
		title: `project-title-${slug}`,
		image: `project-image-${slug}`,
	};
}

// Data fetching and processing
const projects: CollectionEntry<"projects">[] = (await getCollection("projects"))
	.filter((entry) => entry.data.locale === locale && !entry.data.archived)
	.sort(
		(a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
			b.data.date.getTime() - a.data.date.getTime(),
	);
---

<PageLayout
  title={t.work.pageTitle}
  description={t.work.seoDescription}
>
  <div class="section">
    <h1 class={styles.work__title}>{t.work.title}</h1>
    <p class={styles.work__description}>
      {t.work.description}
    </p>
  </div>
  <section>
    <ul class={styles.work__grid} data-testid="work-grid">
      {
        projects.map((project) => {
          const thumbnailPath = normalizeThumbnailPath(project.data.thumbnail);
          const theme = getProjectTheme(project);
          const transitionNames = getTransitionNames(project.id);
          const cardStyle = {
            "--work-background": theme.background,
            "--work-foreground": theme.foreground,
          };

          return (
            <li>
              <a
                href={contentUrl(locale, "work", project.id)}
                class={styles.work__card}
                style={cardStyle}
                data-testid="work-card"
              >
                <div class={styles["work__card-thumbnail"]}>
                  <Image
                    class={styles["work__card-thumbnail-image"]}
                    src={thumbnailPath}
                    width={THUMBNAIL_DIMENSIONS.width}
                    height={THUMBNAIL_DIMENSIONS.height}
                    alt={project.data.title + " " + t.work.thumbnail}
                    loading="lazy"
                    transition:name={transitionNames.image}
                  />
                </div>
                <div class={styles["work__card-content"]}>
                  <h2
                    class={styles["work__card-content-title"]}
                    transition:name={transitionNames.title}
                    data-testid="work-card-title"
                  >
                    {project.data.title}
                  </h2>
                  <p class={styles["work__card-content-subtitle"]} data-testid="work-card-subtitle">{project.data.shortDescription}</p>
                  <time
                    class={styles["work__card-content-meta"]}
                    datetime={project.data.date.toISOString()}
                    data-testid="work-card-meta"
                  >
                    {formatProjectDate(project.data.date)}
                  </time>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</PageLayout>
