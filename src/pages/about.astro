---
import Bio from "../components/sections/Bio/Bio.astro";
import Experience from "../components/sections/Experience/Experience.astro";
import ExpertiseAndServices from "../components/sections/ExpertiseAndServices/ExpertiseAndServices.astro";
import Hero from "../components/sections/Hero/Hero.astro";
import LetsConnect from "../components/sections/LetsConnect/LetsConnect.astro";
import Skills from "../components/sections/Skills/Skills.astro";
import PAGE_CONTENT from "../data/index.json";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
	title="About João Dias - Frontend Engineer specializing in Web Accessibility"
	description="Learn about João Dias, a Frontend Engineer specializing in Web Accessibility from Coimbra, Portugal."
>
  <h1 class="sr-only">About me</h1>
  <div class="content">
    <Hero
      title={PAGE_CONTENT.about.title}
      profilePicture={{
        src: PAGE_CONTENT.about["profile-picture"].src,
        width: PAGE_CONTENT.about["profile-picture"].width,
        height: PAGE_CONTENT.about["profile-picture"].height,
        alt: PAGE_CONTENT.about["profile-picture"].alt,
      }}
    />
    <Bio />
    <ExpertiseAndServices />
    <Experience />
    <Skills />
    <LetsConnect />
  </div>
</PageLayout>
