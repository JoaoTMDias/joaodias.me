---
import Bio from "../components/bio/index.astro";
import Experience from "../components/experience/index.astro";
import Hero from "../components/hero/index.astro";
import LetsConnect from "../components/lets-connect/index.astro";
import Skills from "../components/skills/index.astro";
import PAGE_CONTENT from "../data/index.json";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
	title="About João Dias - Frontend Engineer specializing in Web Accessibility"
	description="Learn about João Dias, a Frontend Engineer specializing in Web Accessibility from Coimbra, Portugal. Currently at Feedzai."
>
	<main>
		<h1 class="sr-only">About page</h1>
		<div class="content">
      <Hero
        title={PAGE_CONTENT.about.title}
        profilePicture={{
          src: PAGE_CONTENT.about["profile-picture"].src,
          width: PAGE_CONTENT.about["profile-picture"].width,
          height: PAGE_CONTENT.about["profile-picture"].height,
          alt: PAGE_CONTENT.about["profile-picture"].alt,
        }}
      />
			<Bio />
			<Experience />
      <Skills />
      <LetsConnect />
		</div>
	</main>
</PageLayout>
