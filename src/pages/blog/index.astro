---
import { getCollection } from "astro:content";
import clsx from "clsx";
import BlogSearch from "../../components/widgets/BlogSearch/BlogSearch";
import PageLayout from "../../layouts/PageLayout.astro";
import styles from "./index.module.scss";

const articles = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const searchableArticles = articles.map((article) => ({
	id: article.id,
	title: article.data.title,
	excerpt: article.data.excerpt,
	category: article.data.category,
	tags: article.data.tags ?? [],
	featuredImage: article.data.featuredImage,
	readingTime: article.data.readingTime,
	pubDateISO: article.data.pubDate.toISOString(),
	pubDateLabel: article.data.pubDate.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	}),
}));
---

<PageLayout
  title="Blog - João Dias"
  description="Articles about Frontend Engineering and Web Accessibility by João Dias"
>
	<div class="content">
		<section class={clsx("section", styles.header)}>
			<h1 class={styles.header__title}>Blog</h1>
			<p>Find a topic of your choice</p>
		</section>
		<BlogSearch articles={searchableArticles} client:load />
	</div>
</PageLayout>
