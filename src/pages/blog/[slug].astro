---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
	const articles = await getCollection("blog");
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

type Props = {
	article: CollectionEntry<"blog">;
};

function getTransitionNames(slug: string) {
  return {
    title: `article-title-${slug}`,
    image: `article-image-${slug}`,
  };
}

const { article } = Astro.props;
const { Content } = await render(article);
const transitionNames = getTransitionNames(article.id);
---

<PageLayout
  title={`${article.data.title} - João Dias`}
  description={article.data.excerpt}
  itemtype="http://schema.org/Article"
>
  <main>
    <article class="section blog-article" itemprop="articleBody">
      <div class="blog-article__header">
        <Image
          class="blog-article__image"
          src={article.data.featuredImage}
          width={960}
          height={480}
          alt={article.data.title}
          loading="lazy"
          transition:name={transitionNames.image}
        />
        <h1 class="blog-article__title" transition:name={transitionNames.title}>{article.data.title}</h1>
        <div class="blog-article__meta">
          <time datetime={article.data.pubDate.toISOString()}>
            {
              article.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          <span class="blog-article__category">{article.data.category.replace("-", " ")}</span>
          {article.data.readingTime && <span>{article.data.readingTime} min read</span>}
        </div>
      </div>
      <div class="blog-article__content">
        <Content />
      </div>
      <div class="blog-article__back-link">
        <a href="/blog">← Back to Articles</a>
      </div>
    </article>
  </main>
</PageLayout>
