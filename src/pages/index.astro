        </div>
      </section>
    </div>
  </main>
</PageLayout>

<style lang="scss">
  @use "../assets/styles/custom-media.scss";

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
    width: 100%;
  }
</style>
