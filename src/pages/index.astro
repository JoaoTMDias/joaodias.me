---
import ExpertiseAndServices from "../components/expertise-and-services/index.astro";
import FeaturedWork from "../components/featured-work/index.astro";
import Hero from "../components/hero/index.astro";
import LatestArticles from "../components/latest-articles/index.astro";
import LetsConnect from "../components/lets-connect/index.astro";
import PeerFeedback from "../components/peer-feedback/index.astro";
import RadioBroadcasts from "../components/radio-broadcasts/index.astro";
import PAGE_CONTENT from "../data/index.json";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title={PAGE_CONTENT.title} description="João Dias">
  <h1 class="sr-only">Home page</h1>
  <div class="content">
    <Hero
      title={PAGE_CONTENT.hero.title}
      subtitle={PAGE_CONTENT.hero.subtitle}
      intro={PAGE_CONTENT.hero.intro}
      profilePicture={{
        src: PAGE_CONTENT.hero["profile-picture"].src,
        width: PAGE_CONTENT.hero["profile-picture"].width,
        height: PAGE_CONTENT.hero["profile-picture"].height,
        alt: PAGE_CONTENT.hero["profile-picture"].alt,
      }}
    />
    <LatestArticles />
    <FeaturedWork />
    <ExpertiseAndServices />
    <RadioBroadcasts />
    <PeerFeedback />
    <LetsConnect />
  </div>
</PageLayout>
