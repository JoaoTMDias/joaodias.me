---
import ExpertiseAndServices from "../components/sections/ExpertiseAndServices/ExpertiseAndServices.astro";
import FeaturedWork from "../components/sections/FeaturedWork/FeaturedWork.astro";
import Hero from "../components/sections/Hero/Hero.astro";
import LatestArticles from "../components/sections/LatestArticles/LatestArticles.astro";
import LetsConnect from "../components/sections/LetsConnect/LetsConnect.astro";
import PeerFeedback from "../components/sections/PeerFeedback/PeerFeedback.astro";
import RadioBroadcasts from "../components/sections/RadioBroadcasts/RadioBroadcasts.astro";
import EN_CONTENT from "../data/index.json";
import PT_CONTENT from "../data/index.pt.json";

const isPt = Astro.currentLocale === "pt";
const PAGE_CONTENT = isPt ? PT_CONTENT : EN_CONTENT;

import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title={PAGE_CONTENT.title} description="João Dias">
  <h1 class="sr-only">{isPt ? "P�gina inicial" : "Home page"}</h1>
  <div class="content">
    <Hero
      title={PAGE_CONTENT.hero.title}
      subtitle={PAGE_CONTENT.hero.subtitle}
      intro={PAGE_CONTENT.hero.intro}
      profilePicture={{
        src: PAGE_CONTENT.hero["profile-picture"].src,
        width: PAGE_CONTENT.hero["profile-picture"].width,
        height: PAGE_CONTENT.hero["profile-picture"].height,
        alt: PAGE_CONTENT.hero["profile-picture"].alt,
      }}
    />
    <LatestArticles />
    <FeaturedWork />
    <ExpertiseAndServices />
    <RadioBroadcasts />
    <PeerFeedback />
    <LetsConnect />
  </div>
</PageLayout>
