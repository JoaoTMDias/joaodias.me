---
import FeaturedWork from "../components/featured-work/index.astro";
import ExpertiseAndServices from "../components/expertise-and-services/index.astro";
import RadioBroadcasts from "../components/radio-broadcasts/index.astro";
import Hero from "../components/hero/index.astro";
import LatestArticles from "../components/latest-articles/index.astro";
import PAGE_CONTENT from "../data/index.json";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title={PAGE_CONTENT.title} description="João Dias">
  <main>
    <h1 class="sr-only">Home page</h1>
    <div class="content">
      <Hero />
      <LatestArticles />
      <FeaturedWork />
      <ExpertiseAndServices />
      <RadioBroadcasts />
      <section id="peer-feedback">
        <h2>What Peers and Leaders Say</h2>
        <p>Here's what engineering leaders and design partners say about working with me</p>
        <div class="feedback-grid">
          <article class="testimonial">
            <img class="testimonial__avatar" width="64" height="64" alt="" />
            <h3 class="testimonial__title">A high-valuable asset</h3>
            <p class="testimonial__sentence">
              João is the engineer who guarantees quality. His focus on sustainable architecture,
              performance, and accessibility ensures we deliver high-impact products—not just
              features. He's an essential asset to any senior engineering team.
            </p>
            <p class="testimonial__name">
              <span class="sr-only">Testimonial from&nbsp;</span>Henrique Macedo, <span
                class="sr-only"
                >who is a
              </span>VP of Engineering at LayerX
