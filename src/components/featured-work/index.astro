---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import clsx from "clsx";
import SectionLink from "../section-link/index.astro";
import SectionTitle from "../section-title/index.astro";
import FeaturedWorkItem from "./FeaturedWorkItem.astro";
import styles from "./index.module.scss";

// Data fetching and processing
type ProjectItem = CollectionEntry<"projects">;

const projects: ProjectItem[] = (await getCollection("projects"))
	.sort((a: ProjectItem, b: ProjectItem) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 4);
---

<section id="featured-work" class={styles["featured-work"]}>
  <div class={clsx("section__container", styles["featured-work__content"])}>
    <SectionTitle text="Featured Work" number={2} />
    <div class={styles["featured-work__list"]}>
      {projects.map((project) => <FeaturedWorkItem key={project.id} project={project} />)}
    </div>
  </div>
  <SectionLink href="/projects" text="Visit all featured projects" />
</section>
