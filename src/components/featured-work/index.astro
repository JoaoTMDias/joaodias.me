---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import FeaturedWorkItem from "./FeaturedWorkItem.astro";

// Data fetching and processing
const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<section id="featured-work">
  <div class="section__container featured-work">
    <h2>Featured Work</h2>
    <div class="featured-work__list">
      {projects.map((project) => <FeaturedWorkItem key={project.slug} project={project} />)}
    </div>
  </div>
  <a href="/projects" class="button button--primary featured-work__cta">Visit all projects page</a>
</section>

<style lang="scss">
  .featured-work {
    width: 100%;
  }

  .featured-work__list {
    display: grid;
    grid-gap: 2rem;
    grid-template-rows: auto;
    grid-template-columns: 1fr;
    grid-auto-columns: 1fr;
    align-items: stretch;
    width: 100%;

    @media (width > 68.75rem) {
      grid-template-columns: 1fr 1fr;
      grid-gap: 2.5rem;
    }
  }

  .featured-work__cta {
    width: max-content;
    align-self: center;
  }
</style>
