---
import { getCollection } from "astro:content";
import LatestArticle from "./LatestArticle.astro";

const articles = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);
---

<section id="latest-articles">
  <div class="articles latest__articles section__container">
    <h2>Latest Insights</h2>
    <p>Here are my latest articles on web development.</p>
    <div class="articles__list">
      {
        articles.map((article) => (
          <LatestArticle
            id={article.id}
            title={article.data.title}
            pubDate={article.data.pubDate}
            excerpt={article.data.excerpt}
            featuredImage={article.data.featuredImage}
            readingTime={article.data.readingTime}
          />
        ))
      }
    </div>
  </div>
  <a class="button button--primary articles__cta" href="/articles">Visit all articles page</a>
</section>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";
  .articles {
    border: 2px solid var(--palette-yellow-main);
    background-color: var(--palette-yellow-background);
    background-image: url(/grid-yellow.svg), url(/white-texture.png);
    background-position:
      0 0,
      0 0;
    background-size: auto, auto;
    border-radius: var(--section-border-radius);

    p {
      font-size: var(--font-size-md);
      margin-bottom: 2rem;
    }
  }

  .articles__list {
    display: grid;
    grid-gap: 2rem;
    grid-template-rows: auto;
    grid-template-columns: 1fr;
    grid-auto-columns: 1fr;
    align-items: stretch;
    width: 100%;

    @media (--medium-viewport) {
      grid-template-columns: repeat(2, 1fr);
      grid-gap: 2.5rem;
    }

    @media (--full-hd-viewport) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .articles__cta {
    width: max-content;
    align-self: center;
    margin-top: 2rem;
  }
</style>
