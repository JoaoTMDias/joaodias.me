---
import { Image } from "astro:assets";
import styles from "./index.module.scss";

interface Props {
  id: string;
  title: string;
  pubDate: Date;
  excerpt: string;
  featuredImage?: string;
  readingTime?: number;
}

const { id, title, pubDate, featuredImage, readingTime } = Astro.props;

function getTransitionNames(slug: string) {
	return {
		title: `article-title-${slug}`,
		image: `article-image-${slug}`,
	};
}


const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const transitionNames = getTransitionNames(id);

---

<article class={styles["featured-article"]}>
  <a href={`/blog/${id}`} class={styles["featured-article__link"]} aria-hidden="true" tabindex="-1">
    {
      featuredImage && (
        <Image
          class={styles["featured-article__cover"]}
          src={featuredImage}
          width="960"
          height="480"
          loading="lazy"
          alt=""
          transition:name={transitionNames.image}
        />
      )
    }
    <div class={styles["featured-article__content"]}>
      <time datetime={pubDate.toISOString()} class={styles["featured-article__date"]}
        ><span class="sr-only">Published on</span>&nbsp;{formattedDate}</time
      >
      <h3 class={styles["featured-article__title"]} transition:name={transitionNames.title}>{title}</h3>
      {readingTime && <p class={styles["featured-article__reading-time"]}>{readingTime} min read</p>}
    </div>
  </a>
</article>
