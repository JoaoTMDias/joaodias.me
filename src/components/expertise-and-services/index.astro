---
import clsx from "clsx";
import SectionTitle from "../section-title/index.astro";
import styles from "./index.module.scss";
---

<script>
  import "../jd-accordion/index";
</script>

<section id="expertise-and-services" class="section section__stack">
  <div class={clsx("section__container", styles.services__container)}>
    <SectionTitle text="Expertise & Services" />

    <p class={styles.services__intro}>
      I help organizations build accessible, high-performing digital experiences that don't just
      meet EAA, ADA, and WCAG standards - they exceed them, creating sustainable compliance
      frameworks that scale with regulatory evolution.
    </p>

    <div class={styles.services__list}>
      <jd-accordion>
        <jd-accordion-item
          category="Consulting & Education"
          label="Custom Accessibility & Design System Workshops"
          open
        >
          <p>
            Hands-on, tailored training that aligns corporate and academic teams on accessibility
            best practices. I translate complex standards into actionable workflows that ensure
            WCAG, EAA, and ADA compliance while establishing scalable, inclusive Design System
            foundations.
          </p>
        </jd-accordion-item>

        <jd-accordion-item
          category="Consulting & Education"
          label="Thought Leadership & Public Speaking"
        >
          <p>
            Engaging presentations and keynotes for conferences, companies, and
            universities—exploring the intersection of UX excellence, frontend performance, and
            strategic accessibility planning. Each session connects technical precision with
            human-centered design outcomes.
          </p>
        </jd-accordion-item>

        <jd-accordion-item
          category="Engineering & Systems"
          label="Accessible Frontend Development"
        >
          <p>
            Building high-quality, high-performance web applications with an unwavering focus on{" "}
            <strong>global accessibility compliance and governance</strong>. My engineering approach
            delivers maintainable, standards-based code that's both fast and inclusive by design.
          </p>
        </jd-accordion-item>

        <jd-accordion-item
          category="Auditing & Strategy"
          label="Performance & Quality Audits"
        >
          <p>
            Strategic, in-depth analysis of existing codebases—delivering clear, actionable roadmaps
            to achieve international legal compliance (WCAG, EAA, ADA), optimize performance, and
            elevate overall product quality and sustainability.
          </p>
        </jd-accordion-item>
      </jd-accordion>
    </div>

  </div>
</section>
