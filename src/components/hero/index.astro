---
import Profile from "../profile/index.astro";
---

<section class="section">
  <div class="hero__container">
    <div class="hero__greeting">
      <h2 class="title">
        <span class="title__hi">Hi, I'm João.<span aria-hidden="true">👋</span></span>
        <span class="title__main"
          >Bridging UX & Engineering to build better, more inclusive digital products.</span
        >
      </h2>
    </div>
    <div class="hero__picture">
      <Profile />
    </div>
    <p class="hero__intro">
      As a Senior Frontend Engineer based in Coimbra (Portugal), I specialize in accessible and
      scalable Design Systems, performance optimization, and robust frontend architecture.
    </p>
    <div class="hero__actions">
      <a href="#connect" class="button button--primary">Let's discuss a role or project</a>
      <a href="/articles" class="button button--secondary">Read my insights</a>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    width: 100%;
    height: auto;
    position: relative;

    &__container {
      display: grid;
      grid-template-areas:
        "greeting"
        "picture"
        "intro"
        "actions";
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 1.5rem;
      width: 100%;
      height: auto;
      background-color: var(--palette-pink-main);
      border-radius: inherit;

      @media (--medium-viewport) {
        padding-block: 0rem;
        grid-template-areas:
          "greeting picture"
          "intro picture"
          "actions picture";
        grid-template-columns: 55% 45%;
        gap: 0;
      }

      @media (--large-viewport) {
        grid-template-columns: 50% 50%;
      }
    }

    &__greeting,
    &__intro,
    &__actions {
      padding-inline: 1.5rem;
    }

    &__greeting {
      grid-area: greeting;

      @media (--medium-viewport) {
        padding-block-start: 1.5rem;
      }
    }

    &__picture {
      grid-area: picture;
      width: 100%;
      display: flex;
      justify-content: center;
      background-color: var(--palette-amber-main);
    }

    &__intro {
      grid-area: intro;
      font-family: var(--text-font-family);
      font-style: normal;
      font-weight: 400;
      font-size: 1.5rem;
      line-height: 2rem;
      color: var(--text-color);
      margin-bottom: 2rem;
    }

    &__actions {
      grid-area: actions;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;

      @media (--medium-viewport) {
        padding-block-end: 1.5rem;
      }
    }
  }

  .title {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    gap: 1rem;

    &__hi {
      font-family: var(--text-font-family);
      font-style: normal;
      font-weight: 400;
      font-variation-settings: "wght" 400;
      font-size: 1.5rem;
      line-height: 1.2;
      color: var(--text-color);
    }

    &__main {
      font-family: var(--heading-font-family);
      font-style: normal;
      font-weight: 700;
      font-variation-settings: "wght" 700;
      font-size: var(--font-size-xxl);
      line-height: 1.2;
      color: var(--text-color);
    }
  }
</style>
