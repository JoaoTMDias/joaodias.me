---
import PAGE_CONTENT from "../../data/index.json";
import Profile from "../profile/index.astro";
---

<section class="hero">
	<div class="hero__greeting">
		<h2 class="title">
			<span class="title__hi">Hi, I'm João.<span aria-hidden="true">👋</span></span>
			<span class="title__main">Bridging UX & Engineering to Build Faster, More Inclusive Digital Products.</span>
		</h2>
		<p class="intro">
			As a Senior Frontend Engineer based in Coimbra, I specialize in scalable Design Systems, performance optimization, and robust frontend architecture—bridging the gap between UX vision and engineering execution.
		</p>
		<a href="/contacts" class="button button__hero--secondary">Let's discuss a project or role</a>
		<a href="/articles" class="button button__hero--primary">Read my insights</a>
	</div>
	<div class="hero__picture"></div>
	<Profile />
</section>

<style lang="scss">
	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 1rem;
		width: 100%;
		height: auto;
		position: relative;

		@media (min-width: 60rem) {
			height: calc(100vh - var(--header-height));
		}
	}

	.fake-copyright {
		position: relative;

		@media (min-width: 60rem) {
			content: "";
			position: absolute;
			left: auto;
			right: auto;
			bottom: 1rem;
			right: 1rem;
		}

		&__text {
			text-align: right;
			line-height: 2rem;
			margin-bottom: 1rem;
			margin-right: 1.25rem;

			@supports (animation-timeline: view()) {
				@media (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
					transform: scale(1);
					opacity: 1;
					view-timeline-name: --revealing-image;
					view-timeline-axis: block;
					animation: linear scaleText both;
					animation-timeline: --revealing-image;
					animation-range: entry 50% cover 80%;
				}
			}
		}
	}

	@keyframes scaleText {
		0% {
			transform: scale(1);
		}

		100% {
			transform: scale(1.25);

		}
	}
</style>
