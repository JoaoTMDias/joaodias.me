---
import Profile from "../profile/index.astro";
---

<section class="section">
  <div class="hero__container">
    <h2 class="hero__title">I bridge UX and Engineering</h2>
    <div class="hero__picture">
      <Profile />
    </div>
    <p class="hero__name">João Dias</p>
    <p class="hero__intro">
      I'm a Senior Frontend Engineer specializing in Web Accessibility from Portugal.
    </p>
    <svg class="hero__arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 261">
      <path stroke="var(--text-color)" d="M12.66.178V163"></path>
      <path
        fill="var(--text-color)"
        d="M12.762 163.25c2.916 0 5.105.42 6.714 1.271 1.6.846 2.644 2.126 3.258 3.889.618 1.773.802 4.04.661 6.849-.14 2.807-.605 6.137-1.272 10.026-2.665 15.553-8.538 39.952-9.605 75.202l.49.016c1.065-35.203 6.928-59.552 9.598-75.132.667-3.894 1.136-7.248 1.278-10.086.143-2.837-.04-5.18-.689-7.043-.652-1.873-1.776-3.256-3.494-4.165-1.707-.903-3.986-1.327-6.939-1.327v.5Z"
      ></path>
      <path
        fill="var(--text-color)"
        d="M12.762 163.25c-3.328 0-5.833.421-7.678 1.277-1.835.851-3.024 2.136-3.721 3.893-.702 1.768-.913 4.03-.752 6.837.16 2.805.69 6.133 1.449 10.022 3.036 15.552 9.73 39.954 10.947 75.207l-.49.018c-1.214-35.2-7.895-59.545-10.937-75.128-.76-3.894-1.296-7.249-1.458-10.09-.162-2.839.045-5.186.787-7.054.746-1.879 2.027-3.257 3.972-4.16 1.936-.898 4.522-1.322 7.881-1.322v.5Z"
      ></path>
    </svg>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    width: 100%;
    height: auto;
    position: relative;

    &__container {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-column-gap: var(--space-xs);
      grid-row-gap: var(--space-lg);
      align-content: start;
      width: 100%;
      height: auto;
      color: var(--text-color);

      @media (--large-viewport) {
        grid-template-columns: repeat(12, 1fr);
      }
    }

    &__title,
    &__name {
      padding-block-start: var(--space-lg);
      display: flex;
      align-items: start;
      gap: 1rem;
      font-size: var(--font-size-xl);
      font-family: var(--heading-font-family);
      font-style: normal;
      font-weight: 700;
      font-variation-settings: "wght" 700;
      line-height: 1.2;
    }

    &__title,
    &__name {
      grid-column-start: 1;
      grid-column-end: 6;
      justify-content: start;
    }

    &__picture {
      grid-column-start: 1;
      grid-column-end: 6;
      grid-row-start: 2;
      width: 100%;
      height: auto;
      display: flex;
      align-items: start;
      justify-content: start;
      aspect-ratio: 1/1;
    }

    &__intro {
      grid-column-start: 1;
      grid-column-end: 6;
      grid-row-start: 4;
      align-self: start;
      font-family: var(--text-font-family);
      font-style: normal;
      font-weight: 400;
      font-size: 1.5rem;
      line-height: 1.333;
      color: var(--text-color);
    }

    &__arrow {
      grid-column-start: 6;
      grid-column-end: -1;
      grid-row-start: 4;
      height: 5rem;
      align-self: end;
      justify-content: center;
      width: 24px;
      height: auto;
    }
  }
</style>
