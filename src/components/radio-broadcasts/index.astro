---
import WavyLines from "../squiggle/waves.astro";
import Show from "./Show";
---

<section id="radio-broadcasts">
  <div class="section__container broadcasts">
    <h2 class="broadcasts__title">
      Over-the-air <span aria-hidden="true">📻🎙️</span>
    </h2>
    <p class="broadcasts__intro">
      I am also a <strong
        ><a href="https://ruc.pt/autor/joaotmdias" target="_blank" rel="noreferrer" lang="pt-PT"
          >radio host at Rádio Universidade de Coimbra (RUC)</a
        ></strong
      >, where I regularly broadcast shows that range from Jazz, Blues, Rock, Punk and Heavy Metal.
    </p>
    <div class="broadcasts__shows">
      <Show
        href="https://ruc.pt/podcast/mel-e-tal/05-de-janeiro-de-2026-os-melhores-do-ano-parte-1-de-2"
        cover="https://ruc.pt/_next/image?url=https%3A%2F%2Fbucket.ruc.pt%2Fwp-content%2Fuploads%2F2025%2F12%2F29171613%2Fcave-107-9-post.jpg&w=3840&q=75"
        name="Cave 107.9"
        date="29/11/2025"
        title="Cave 107.9, 29 de Dezembro de 2025"
        description="Das luzes de Baltimore à sujidade do UK, resumimos o ano do Punk e Hardcore em 21 faixas essenciais. Uma hora de rádio em alta voltagem com Turnstile, Scowl, Biohazard e muito mais. Se o mosh não parou em 2025, o Cave também não. Ouve agora o balanço final!"
      />
      <Show
        href="https://ruc.pt/podcast/mel-e-tal/05-de-janeiro-de-2026-os-melhores-do-ano-parte-1-de-2"
        cover="https://ruc.pt/_next/image?url=https%3A%2F%2Fbucket.ruc.pt%2Fwp-content%2Fuploads%2F2026%2F01%2F05091026%2Fcover.jpeg&w=3840&q=75"
        name="Mel e Tal"
        date="26/11/2025"
        title="05 de Janeiro de 2026, os melhores do ano (parte 1 de 2)"
        description="Do peso esmagador à melodia mais refinada, nesta primeira parte dos álbuns do ano de 2025, o Mel Tal separa o mel da cera. Uma hora de excelência metálica que coloca à prova os discos que resistiram ao teste do tempo e do basqueiro!"
      />
      <Show
        href="https://ruc.pt/podcast/mel-e-tal/05-de-janeiro-de-2026-os-melhores-do-ano-parte-1-de-2"
        cover="https://ruc.pt/_next/image?url=https%3A%2F%2Fbucket.ruc.pt%2Fwp-content%2Fuploads%2F2025%2F12%2F29171613%2Fcave-107-9-post.jpg&w=3840&q=75"
        name="Cave 107.9"
        date="29/11/2025"
        title="Cave 107.9, 29 de Dezembro de 2025"
        description="Das luzes de Baltimore à sujidade do UK, resumimos o ano do Punk e Hardcore em 21 faixas essenciais. Uma hora de rádio em alta voltagem com Turnstile, Scowl, Biohazard e muito mais. Se o mosh não parou em 2025, o Cave também não. Ouve agora o balanço final!"
      />
      <Show
        href="https://ruc.pt/podcast/mel-e-tal/05-de-janeiro-de-2026-os-melhores-do-ano-parte-1-de-2"
        cover="https://ruc.pt/_next/image?url=https%3A%2F%2Fbucket.ruc.pt%2Fwp-content%2Fuploads%2F2026%2F01%2F05091026%2Fcover.jpeg&w=3840&q=75"
        name="Mel e Tal"
        date="26/11/2025"
        title="05 de Janeiro de 2026, os melhores do ano (parte 1 de 2)"
        description="Do peso esmagador à melodia mais refinada, nesta primeira parte dos álbuns do ano de 2025, o Mel Tal separa o mel da cera. Uma hora de excelência metálica que coloca à prova os discos que resistiram ao teste do tempo e do basqueiro!"
      />
    </div>
    <WavyLines />
  </div>
  <a class="button button--primary broadcasts__cta" href="https://ruc.pt/autor/joaotmdias"
    >All my shows on RUC</a
  >
</section>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .broadcasts {
    width: 100%;
    background-color: var(--palette-green-background);
    background-image: url(/white-texture.png);
    background-position: 0 0;
    background-size: auto;
    margin-top: 1.5rem;
    position: relative;
    border-radius: var(--section-border-radius);
    overflow: visible;

    &__intro {
      margin-bottom: var(--space-lg);

      @media (--laptop-viewport) {
        margin-bottom: var(--space-xl);
      }
    }

    &__shows {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: var(--space-base);
      position: relative;
      z-index: 1;

      @media (--large-viewport) {
        grid-template-columns: repeat(auto-fit, minmax(26rem, 1fr));
        gap: var(--space-lg);
      }

      @media (--laptop-hd-viewport) {
        grid-template-columns: repeat(auto-fit, minmax(36rem, 1fr));
        gap: var(--space-lg);
      }
    }

    &__cta {
      width: max-content;
      align-self: center;
      margin-top: var(--space-lg);
    }
  }
</style>
