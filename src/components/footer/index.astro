---
import { getEntry } from "astro:content";
import CurrentlyListening from "../currently-listening/index";
import DeployInfo from "../deploy-info/index.astro";
import SocialLinks from "../footer/social-links.astro";
import FooterLinks from "../footer/footer-links.astro";
import SitemapLinks from "../footer/sitemap-links.astro";
import styles from "./footer.module.scss";
import { classNames } from "@jtmdias/js-utilities";

const config = await getEntry("config", "config");
const currentYear = new Date().getFullYear();
const copyright = `© ${currentYear} - ${config.data.copyright}`;
---

<footer class={classNames(styles.footer, "section")} id="footer">
  <div class={classNames(styles.footer__container, "section__container")}>
    <div class="currently-listening" data-testid="currently-listening">
      <h2
        id="current-listening"
        class="currently-listening__title"
        data-testid="currently-listening-main-title"
      >
        <span class="sr-only">I am</span>&nbsp;{config.data.footer.currentlyListeningTitle}
      </h2>
      <div class="currently-listening__container">
        <CurrentlyListening marqueeConfig={config.data.footer.marquee} client:load />
      </div>
    </div>
    <div class={styles.footer__bottom}>
      <SocialLinks />
      <FooterLinks />
      <SitemapLinks />
      <div class={styles.footer__meta}>
        <p class={styles.footer__copyright}>{copyright}</p>
        <DeployInfo />
      </div>
    </div>

    <div class={styles.footer__name}>
      <img src="footer-name.svg" width="208" height="36" alt="" />
    </div>
  </div>
</footer>
