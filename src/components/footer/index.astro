---
import { getEntry } from "astro:content";
import classNames from "clsx";
import CurrentlyListening from "../currently-listening/index";
import DeployInfo from "../deploy-info/index.astro";
import SectionTitle from "../section-title/index.astro";
import styles from "./footer.module.scss";
import FooterBio from "./footer-bio.astro";
import FooterLinks from "./footer-links.astro";
import FooterMeta from "./footer-meta.astro";
import SocialLinks from "./social-links.astro";

const config = await getEntry("config", "config");
const currentYear = new Date().getFullYear();
const copyright = `© ${currentYear} - ${config?.data.copyright}`;
const footerConfig = config?.data.footer as { player?: Record<string, unknown> } | undefined;
const playerConfig = footerConfig?.player;
---

<footer class={classNames("section", styles.footer)} id="footer">
  <div class={classNames("section__container", styles.footer__container)}>
    <div class={classNames("section__stack", styles.footer__currentlyListening)} data-testid="currently-listening">
      <SectionTitle text="Currently Listening" number={7}/>
      <CurrentlyListening playerConfig={playerConfig} client:load />
    </div>
    <div class={styles.footer__bottom}>
      <FooterBio />
      <SocialLinks />
      <FooterLinks />
      <FooterMeta copyright={copyright} />
    </div>
  </div>
</footer>
