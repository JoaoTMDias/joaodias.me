---
import styles from "./sitemap-links.module.scss";

const config = [
	{
		link: "#",
		title: "About me",
	},
	{
		link: "#",
		title: "Articles",
	},
	{
		link: "#",
		title: "Work",
	},
	{
		link: "#",
		title: "Uses",
	},
];
---

<div id="sitemap-links" class={styles["sitemap-links"]} aria-labelledby="footer-title">
  <h2 id="footer-title" class={styles["sitemap-links__title"]}>
    Sitemap <span class="sr-only">Links</span>
  </h2>
  <ul class={styles["sitemap-links__list"]}>
    {
      config.map((link) => (
        <li class={styles["sitemap-links__item"]}>
          <a
            href={link.link}
            target="_blank"
            rel="noopener noreferrer"
            class={styles["sitemap-links__link"]}
          >
            {link.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
