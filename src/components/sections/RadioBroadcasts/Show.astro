---
import { Image } from "astro:assets";
import styles from "./Show.module.scss";

interface Props {
	href: string;
	cover?: string;
	colors?: string[];
	name: string;
	published: Date;
	title: string;
	description?: string;
}

const DEFAULT_COVER =
	"https://ruc.pt/_next/image?url=https%3A%2F%2Fbucket.ruc.pt%2Fwp-content%2Fuploads%2F2026%2F01%2F05091026%2Fcover.jpeg&w=3840&q=75";

const {
	href,
	cover = DEFAULT_COVER,
	colors = [],
	name,
	published,
	title,
	description,
} = Astro.props;

const formattedPublishedDate = published.toLocaleDateString("pt-PT", {
	day: "2-digit",
	month: "2-digit",
	year: "numeric",
});

const [c1, c2, c3] = colors;
const cardStyle: Record<string, string> = {};
if (c1) {
	cardStyle["--show-c1"] = c1;
	cardStyle["--card-bg"] = c1;
}
if (c2) cardStyle["--show-c2"] = c2;
if (c3) cardStyle["--show-c3"] = c3;
---

<article class={styles.show} lang="pt-PT">
	<a href={href} class={styles.card} target="_blank" rel="noopener noreferrer" style={cardStyle}>
		<Image
			class={styles.cover}
			src={cover}
			width={200}
			height={200}
			alt={`${name} - ${title}`}
			loading="lazy"
			decoding="async"
		/>
		<div class={styles.header}>
			<time datetime={published.toISOString()} class={styles.date}>
				<span class="sr-only">Aired on</span>&nbsp;{formattedPublishedDate}
			</time>
			<h3 class={styles.title}>{title}</h3>
			<span class={styles.name}>{name}</span>
		</div>
		<div class={styles.content}>
			{description && <p class={styles.description}>{description}</p>}
			<span class={styles.link}>
				Listen to this show
			</span>
		</div>
	</a>
</article>
