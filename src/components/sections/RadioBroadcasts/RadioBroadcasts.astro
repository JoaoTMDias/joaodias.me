---
import { getCollection } from "astro:content";
import clsx from "clsx";
import SectionLink from "../../ui/SectionLink/SectionLink.astro";
import SectionTitle from "../../ui/SectionTitle/SectionTitle.astro";
import styles from "./RadioBroadcasts.module.scss";
import Show from "./Show.astro";

const shows = (await getCollection("shows"))
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
	.slice(0, 6);
---

<section id="radio-broadcasts" class="section section__stack">
  <div class={clsx("section__container", styles.broadcasts)}>
    <SectionTitle text="Over the air" />
    <p class={styles.broadcasts__intro}>
      I am also a <strong
        ><a href="https://ruc.pt/autor/joaotmdias" target="_blank" rel="noreferrer" lang="pt-PT"
          >radio host at Rádio Universidade de Coimbra (RUC)</a
        ></strong
      >, where I regularly broadcast shows that range from Jazz, Blues, Rock, Punk and Heavy Metal.
    </p>
    <div class={styles.broadcasts__shows}>
      <div class={styles.broadcasts__list}>
        {
          shows.map((show) => {
            const href = `https://ruc.pt/podcast/${show.data.show}/${show.data.slug}`;
            return (
            <Show
              href={href}
              cover={show.data.coverURL}
              colors={show.data.coverColors}
              name={show.data.show}
              date={show.data.published.toLocaleDateString("pt-PT", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
              })}
              title={show.data.title}
              description={show.data.summary}
            />
          )
          })
        }
      </div>
    </div>
  </div>
  <SectionLink href="https://ruc.pt/autor/joaotmdias" text="All my shows on RUC" isExternal={true} />
</section>
