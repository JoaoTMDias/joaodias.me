---
import { Image } from "astro:assets";
import { contentUrl, formatDate, type Locale } from "../../../i18n";
import styles from "./LatestArticles.module.scss";

interface Props {
	id: string;
	title: string;
	pubDate: Date;
	excerpt: string;
	featuredImage?: string;
	readingTime?: number;
	locale: Locale;
}

const { id, title, pubDate, featuredImage, readingTime, locale } = Astro.props;

function getTransitionNames(slug: string) {
	return {
		title: `article-title-${slug}`,
		image: `article-image-${slug}`,
	};
}

const formattedDate = formatDate(pubDate, locale, {
	year: "numeric",
	month: "short",
	day: "numeric",
});
const transitionNames = getTransitionNames(id);
---

<article class={styles["featured-article"]}>
  <a href={contentUrl(locale, "blog", id)} class={styles["featured-article__link"]}>
    {
      featuredImage && (
        <Image
          class={styles["featured-article__cover"]}
          src={featuredImage}
          width="960"
          height="480"
          loading="lazy"
          alt=""
          transition:name={transitionNames.image}
        />
      )
    }
    <div class={styles["featured-article__content"]}>
      <time datetime={pubDate.toISOString()} class={styles["featured-article__date"]}
        ><span class="sr-only">{locale === "pt" ? "Publicado em" : "Published on"}</span>&nbsp;{formattedDate}</time
      >
      <h3 class={styles["featured-article__title"]} transition:name={transitionNames.title}>{title}</h3>
      {readingTime && <p class={styles["featured-article__reading-time"]}>{readingTime} {locale === "pt" ? "min de leitura" : "min read"}</p>}
    </div>
  </a>
</article>
