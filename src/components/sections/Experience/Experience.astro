---
import { getCollection } from "astro:content";
import clsx from "clsx";
import SectionLink from "../../ui/SectionLink/SectionLink.astro";
import SectionTitle from "../../ui/SectionTitle/SectionTitle.astro";
import styles from "./Experience.module.scss";

const [experienceDocument] = (await getCollection("experience")).filter(
	(entry) => entry.data.locale === (Astro.currentLocale === "pt" ? "pt" : "en"),
);
const experienceEntries = experienceDocument?.data.entries ?? [];
const hasCurrentExperience = experienceEntries.some((entry) => entry.isCurrent);
const isPt = Astro.currentLocale === "pt";
---

<div class="section section__stack" id="experience">
  <SectionTitle text={isPt ? "Experi\u00eancia profissional" : "Professional Experience"} />
  <ul
    class={clsx("section__container", styles["experience"])}
    data-testid="professional-experience"
  >
      {
        experienceEntries.map((item) => (
          <li
            class={styles.item}
            data-testid="experience-item"
            data-current={item.isCurrent ? true : undefined}
          >
            <h3 class={styles.title}>{item.title}</h3>
            <p class={styles.description}>{item.description}</p>
            <div class={styles.metadata}>
              <p>
                <>
                  <span class="sr-only">Duration:</span>
                  <span>{item.startDate}</span>
                  <span class="sr-only">until</span>
                  <span aria-hidden="true">-</span>
                  <span>{item.endDate || (isPt ? "Presente" : "Present")}</span>
                </>
              </p>
              <p>
                <>
                  <span class="sr-only">Location:</span>
                  <span>{item.location}</span>
                </>
              </p>
            </div>
          </li>
        ))
      }
  </ul>
  <SectionLink href="/resume-joao-dias.pdf" text={isPt ? "Descarregar o meu curr\u00edculo (PDF)" : "Download my Resume (PDF)"} isExternal={true} />
</div>
