---
import SectionTitle from "../../ui/SectionTitle/SectionTitle.astro";
import styles from "./LetsConnect.module.scss";
import Waves from "./Waves.astro";
---

<section id="lets-connect" class={styles["lets-connect"]}>
  <SectionTitle text="Let's Connect!" />
  <div class={styles["lets-connect__content"]}>
    <Waves />
    <div class={styles["lets-connect__intro"]}>
      <p>
        I'm currently available for Senior Frontend Engineering and Accessibility Consulting roles across Europe and globally.
      </p>
      <p>
        My expertise is uniquely positioned to help organizations build accessible Design Systems, achieve EAA or ADA compliance, or elevate a team's accessibility maturity. I bring the technical depth and strategic insight to deliver results.
      </p>
      <p>
        Let's build digital products that meet the moment.
      </p>
    </div>
  </div>
</section>
