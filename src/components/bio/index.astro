---
import { getEntry } from "astro:content";
import clsx from "clsx";
import SectionTitle from "../section-title/index.astro";
import styles from "./index.module.scss";

const bio = await getEntry("bio", "bio");

type RichTextNode = {
  type?: string;
  text?: string;
  url?: string;
  bold?: boolean;
  italic?: boolean;
  underline?: boolean;
  strike?: boolean;
  children?: RichTextNode[];
};

type RichTextDocument = {
  type: "root";
  children: unknown[];
};

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function escapeAttribute(value: string) {
  return escapeHtml(value);
}

function renderInlineNode(node: RichTextNode): string {
  if (typeof node.text === "string") {
    let content = escapeHtml(node.text);

    if (node.bold) content = `<strong>${content}</strong>`;
    if (node.italic) content = `<em>${content}</em>`;
    if (node.underline) content = `<u>${content}</u>`;
    if (node.strike) content = `<s>${content}</s>`;

    return content;
  }

  const content = (node.children ?? []).map(renderInlineNode).join("");

  if (node.type === "a" && node.url) {
    return `<a href="${escapeAttribute(node.url)}">${content}</a>`;
  }

  return content;
}

function renderParagraphs(nodes: RichTextNode[]) {
  return nodes
    .filter((node) => node.type === "p")
    .map((node) => ({
      html: (node.children ?? []).map(renderInlineNode).join(""),
    }))
    .filter((node) => node.html.trim().length > 0);
}

function renderStringParagraphs(value: string) {
  return value
    .split(/\n\s*\n/g)
    .map((paragraph) => ({ html: escapeHtml(paragraph.trim()) }))
    .filter((paragraph) => paragraph.html.length > 0);
}

function renderDescription(value: string | RichTextDocument) {
  if (typeof value === "string") {
    return renderStringParagraphs(value);
  }

  return renderParagraphs(value.children as RichTextNode[]);
}

const bioParagraphs = bio ? renderDescription(bio.data.description) : [];
---

{bio && (
  <section class="section section__stack" id="bio">
    <SectionTitle text={bio.data.title} />
    <div class="section__container">
        <div class={styles.bio__content}>
          <p class={styles.bio__title} data-testid="bio-intro">{bio.data.mainTitle}</p>
          {
            bioParagraphs.map((paragraph) => {
              return (
                <p
                  class={styles.bio__paragraph}
                  data-testid="bio-description"
                  set:html={paragraph.html}
                />
              );
            })
          }
        </div>
        <div class={styles.bio__picture}>
          <img
            class={styles.bio__image}
            src={bio.data.picture.src}
            width={bio.data.picture.width}
            height={bio.data.picture.height}
            alt={bio.data.picture.alt}
            loading="lazy"
            data-testid="bio-image"
          />
        </div>
    </div>
  </section>
)}
