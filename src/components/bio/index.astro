---
import { getEntry } from "astro:content";
import styles from "./index.module.scss";

const bio = await getEntry("bio", "bio");
---

<div class="sub-section">
  <h3 class="sr-only">{bio.data.title}</h3>
  <div class={styles.bio}>
    <div class={styles.bio__picture}>
      <img
        class={styles.bio__image}
        src={bio.data.picture.src}
        width={bio.data.picture.width}
        height={bio.data.picture.height}
        alt={bio.data.picture.alt}
        loading="lazy"
        data-testid="bio-image"
      />
    </div>
    <div class={styles.bio__content}>
      <h4 class={styles.bio__title} data-testid="bio-intro">{bio.data.mainTitle}</h4>
      {
        bio.data.description.map((paragraph, index) => {
          return (
            <p key={index} class={styles.bio__paragraph} data-testid="bio-description">
              {paragraph}
            </p>
          );
        })
      }
    </div>
  </div>
</div>
