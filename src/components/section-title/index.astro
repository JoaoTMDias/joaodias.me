---
import clsx from "clsx";

interface Props {
	text: string;
  hidden?: boolean;
}

const { text, hidden } = Astro.props;
---

<h2 class={clsx("section__title", {
  "sr-only": hidden
})}>
  <span class="section__title--number" aria-hidden="true"></span>
  <span class="section__title--text">{text}</span>
</h2>
