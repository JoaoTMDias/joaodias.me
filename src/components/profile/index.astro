---
import { Image } from "astro:assets";
import PAGE_CONTENT from "../../data/index.json";
---

<div class="profile">
  <Image
    class="profile__image"
    src={PAGE_CONTENT.hero["profile-picture"].src}
    width={PAGE_CONTENT.hero["profile-picture"].width}
    height={PAGE_CONTENT.hero["profile-picture"].height}
    alt={PAGE_CONTENT.hero["profile-picture"].alt}
    data-testid="profile-picture"
  />
</div>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .profile {
    overflow: hidden;
    position: relative;
    aspect-ratio: 1 / 1;

    &,
    &__image {
      width: 100%;
      height: 100%;
    }

    &__image {
      object-fit: cover;
      object-position: top center;
      position: relative;
      z-index: 0;
      transform: scale(1);
      clip-path: inset(5% 96% 15% 0);
      animation-name: clipPathAnimation;
      animation-duration: 2500ms;
      animation-timing-function: cubic-bezier(0.85, 0, 0.15, 1);
      animation-delay: 200ms;
      animation-fill-mode: forwards;
    }

    @media (--laptop-viewport) {
      max-width: 30vw;
    }
  }

  @keyframes clipPathAnimation {
    0% {
      clip-path: inset(5% 96% 60% 0);
    }
    30% {
      clip-path: inset(5% 0% 60% 0);
    }
    100% {
      clip-path: inset(0% 0 5% 0);
    }
  }
</style>
