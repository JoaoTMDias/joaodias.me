---
import { Image } from "astro:assets";
import PAGE_CONTENT from "../../data/index.json";
import styles from "./index.module.scss";

interface Props {
	src: string;
	width: number;
	height: number;
	alt: string;
}

const { src, width, height, alt } = Astro.props as Props;
---

<div class={styles.profile}>
  <Image
    class={styles.profile__image}
    src={src}
    width={width}
    height={height}
    alt={alt}
    data-testid="profile-picture"
  />
</div>
