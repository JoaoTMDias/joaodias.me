---
import { getEntry } from "astro:content";

const config = await getEntry("config", "config");
const currentPage = Astro.url.pathname;
---

<nav aria-label="Pages" class="main-navigation">
  <ul class="main-navigation__list">
    {
      config.data.nav.map((item) => {
        const isCurrentPage = currentPage === item.link;

        return (
          <li class="main-navigation__item">
            <a
              class="main-navigation__link"
              id={item.id}
              href={item.link}
              aria-label={item.accessibleLabel}
              data-testid="top-nav-link"
              aria-current={isCurrentPage ? "page" : undefined}
            >
              {item.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style lang="scss">
  .main-navigation {
    --main-navigation-background: transparent;

    display: none;
    align-items: stretch;
    background-color: inherit;
    display: flex;
    flex-direction: row;
    height: calc(var(--header-height) - 1rem);
    justify-content: start;
    margin-left: auto;
    position: relative;
    top: 0;
    width: fit-content;
    z-index: inherit;

    @media (width > 48rem) {
      display: flex;
    }
  }

  .main-navigation__list {
    display: none;
    flex-direction: row;
    justify-content: start;
    align-items: stretch;
    list-style: none;
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;

    @media (width > 48rem) {
      display: flex;
    }
  }

  .main-navigation__link {
    font-size: 1.25rem;
    height: 100%;
    align-items: center;
    display: none;
    flex-direction: row;
    gap: 0.5rem;
    justify-content: start;
    padding-inline: 1rem;
    position: relative;
    text-decoration: none;
    width: fit-content;

    &[aria-current="page"] {
      &::after {
        content: "*";
        position: relative;
      }
    }

    @media (width > 48rem) {
      display: flex;
    }
  }
</style>
