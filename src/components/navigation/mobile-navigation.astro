---
import { getEntry } from "astro:content";

const config = await getEntry("config", "config");
const currentPage = Astro.url.pathname;
---

<nav aria-label="Pages" class="mobile-navigation" id="mobile-navigation" popover="auto">
  <ul class="mobile-navigation__list">
    {
      config.data.nav.map((item, index) => {
        const isCurrentPage = currentPage === item.link;

        return (
          <li class="mobile-navigation__item" style={`--delay: ${index * 100}ms`}>
            <a
              class="mobile-navigation__link"
              id={item.id}
              href={item.link}
              aria-label={item.accessibleLabel}
              data-testid="top-nav-link"
              aria-current={isCurrentPage ? "page" : undefined}
            >
              <span class="mobile-navigation__link-text">
                {item.title}
                <svg
                  class="mobile-navigation__link-icon"
                  width="28"
                  height="28"
                  viewBox="0 0 28 28"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M28 14L20.4664 16.6775L23.9017 23.9017L16.6775 20.4664L14 28L11.3225 20.4664L4.09833 23.9017L7.5336 16.6775L0 14L7.5336 11.3225L4.09833 4.09833L11.3225 7.53361L14 0L16.6775 7.53361L23.9017 4.09833L20.4664 11.3225L28 14Z"
                    fill="#221F47"
                  />
                </svg>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .mobile-navigation {
    --main-navigation-background: var(--background-color);
    --main-navigation-background-hover: var(--palette-indigo-main);

    top: var(--header-height);
    left: 0;
    width: 100%;
    flex-direction: column;
    justify-content: end;
    align-items: stretch;
    height: calc(100vh - var(--header-height));
    background-color: var(--main-navigation-background);
    border: none;
    overflow: hidden;

    @media (--medium-viewport) {
      display: none !important;
    }

    &:popover-open {
      display: flex;
    }

    &__list {
      display: flex;
      flex-direction: column;
      justify-content: end;
      align-items: normal;
      list-style-type: none;
      height: auto;
      width: 100%;
      margin: 0 0 var(--space-xl) 0;
      padding: 0;
      gap: var(--space-md);
    }

    &__item {
      @media (--with-motion) {
        animation: fadeInUp 0.6s ease-out both;
        animation-delay: var(--delay, 0ms);
      }
    }

    &__link {
      padding-inline: var(--space-lg);
      display: flex;
      flex-direction: row;
      justify-content: start;
      align-items: center;
      position: relative;
      height: 100%;
      width: 100%;
      text-decoration: none;
      gap: var(--space-xs);

      &:hover,
      &:focus {
        background-color: var(--main-navigation-background-hover);
      }

      &[aria-current="page"] {
        .mobile-navigation__link-text {
          font-weight: 600;
        }
        .mobile-navigation__link-icon {
          display: inline-flex;
        }
      }
    }

    &__link-text {
      font-family: "Playfair Display";
      font-style: italic;
      font-weight: 400;
      font-size: var(--font-size-xxl);
      height: var(--space-xl);
      line-height: 1;
      text-decoration-line: underline;
      text-decoration-thickness: var(--space-xxs);
      text-underline-offset: var(--space-xs);
      color: var(--text-color);
    }

    &__link-icon {
      display: none;
      width: var(--space-md);
      height: var(--space-md);
      fill: var(--text-color);
      margin-left: var(--space-lg);
    }
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(25%);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
