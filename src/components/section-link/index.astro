---
import clsx from "clsx";
import styles from "./index.module.scss";

interface Props {
	text: string;
	href: string;
}

const { text, href } = Astro.props;
---

<a class={clsx("link", styles.section__link)} href={href}>
  <span class={styles.section__link__text}>{text}</span>
  <span class={styles.section__link__arrow} aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 28 28"
      ><path fill="currentColor" d="M15.513 14 10 8.488 11.488 7l7 7-7 7L10 19.512z"></path></svg
    >
  </span>
</a>
