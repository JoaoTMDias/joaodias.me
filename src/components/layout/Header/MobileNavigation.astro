---
import { getEntry } from "astro:content";
import type { Locale } from "../../../i18n";
import { getMessages } from "../../../i18n/messages";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import styles from "./MobileNavigation.module.scss";

interface Props {
	locale: Locale;
	languageUrl: string;
}
const { locale, languageUrl } = Astro.props;
const t = getMessages(locale);
const config = await getEntry("config", locale + "/config");
const currentPage = Astro.url.pathname;
---
<nav aria-label={t.nav.label} class={styles["mobile-navigation"]} id="mobile-navigation" popover="auto"><ul class={styles["mobile-navigation__list"]}>{config?.data.nav.map((item,index)=><li class={styles["mobile-navigation__item"]}><a class={styles["mobile-navigation__link"]} href={item.link} aria-current={currentPage===item.link?"page":undefined}>{item.title}</a></li>)}<li class={styles["mobile-navigation__item"]}><LanguageSwitcher locale={locale} href={languageUrl} /></li></ul></nav>
