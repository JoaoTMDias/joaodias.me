---
import type { Locale } from "../../../i18n";
import { getMessages } from "../../../i18n/messages";
import styles from "./MobileNavigation.module.scss";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = getMessages(locale);
---

<button
  id="mobile-navigation-toggle"
  type="button"
  class={styles["mobile-navigation__toggle"]}
  popovertarget="mobile-navigation"
  popovertargetaction="toggle"
>
  <span class={styles["mobile-navigation__toggle__open"]}>{t.nav.menu}</span>
  <span class={styles["mobile-navigation__toggle__close"]}>{t.nav.close}</span>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.getElementById("mobile-navigation");
    navigation?.addEventListener("toggle", (e) => {
      document.body.style.overflow = (e as ToggleEvent).newState === "open" ? "hidden" : "";
    });
  });

  document.addEventListener("astro:before-swap", () => {
    (document.getElementById("mobile-navigation") as HTMLButtonElement)?.hidePopover();
    document.body.style.overflow = "";
  });
</script>
