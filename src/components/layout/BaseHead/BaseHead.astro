---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../../../assets/styles/index.scss";
import { ClientRouter } from "astro:transitions";
import type { Locale } from "../../../i18n";

export interface Props {
	title: string;
	description: string;
	image?: string;
	locale: Locale;
	alternateUrls?: Partial<Record<Locale, string>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = "/open-graph-picture.jpg",
	locale,
	alternateUrls,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/PlayfairDisplay/PlayfairDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/PlayfairDisplay/PlayfairDisplay-Variable-Italic.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Cabin/Cabin-Variable.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{alternateUrls?.en && <link rel="alternate" hreflang="en" href={new URL(alternateUrls.en, Astro.site)} />}
{alternateUrls?.pt && <link rel="alternate" hreflang="pt-PT" href={new URL(alternateUrls.pt, Astro.site)} />}
{alternateUrls?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternateUrls.en, Astro.site)} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
<slot name="head" slot="head" />
<ClientRouter />
