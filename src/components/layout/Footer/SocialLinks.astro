---
import { getEntry } from "astro:content";
import clsx from "clsx";
import type { SiteConfig } from "../../../typings";
import SectionLink from "../../ui/SectionLink/SectionLink.astro";
import styles from "./SocialLinks.module.scss";

const config: Record<"data", SiteConfig> = await getEntry("config", "config");
---

<div id="links-to-my-social-media" class={styles["social-links"]} aria-labelledby="contact-title">
  <h2 id="contact-title" class={clsx(styles["social-links__title"], "sr-only")}>
    <span class="sr-only">Links to my </span>Social Media
  </h2>
  <ul class={styles["social-links__list"]}>
    {
      config.data.contactLinks.map((link) => (
        <li class={styles["social-links__item"]}>
          <SectionLink href={link.link} text={link.title} isExternal={true} />
        </li>
      ))
    }
  </ul>
</div>
