---
import styles from "./FooterBio.module.scss";

interface Props {
	locale?: "en" | "pt";
}
const { locale = "en" } = Astro.props;
---

<div class={styles["footer-bio"]}>
  <h2 class={styles["footer-bio__name"]}>João Dias</h2>
  <p class={styles["footer-bio__description"]}>{locale === "pt" ? "Engenheiro Frontend sénior, focado em Desenvolvimento Web e Acessibilidade" : "Senior Frontend Engineer, focused on Web Development and Accessibility"}</p>
</div>
