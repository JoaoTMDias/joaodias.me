---
import { getEntry } from "astro:content";

const config = await getEntry("config", "config");
const currentPage = Astro.url.pathname;

---

<nav aria-label="Pages" class="main-navigation">
  {config.data.nav.map((item) => {
    const isCurrentPage = currentPage === item.link;

    return (
      <a
        class="main-navigation__link"
        id={item.id}
        href={item.link}
        aria-label={item.accessibleLabel}
        data-testid="top-nav-link"
        data-current={isCurrentPage ? "" : undefined}
      >
        {item.title}
      </a>
    );
  })}
</nav>

<style lang="scss">
  .main-navigation {
    --main-navigation-background: purple;

    position: fixed;
    top: var(--header-height);
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: stretch;
    height: calc(100vh - var(--header-height));
    z-index: 1;
    background-color: var(--main-navigation-background);

    &__link {
      padding-inline: 2rem;
      display: flex;
      flex-direction: row;
      justify-content: start;
      align-items: center;
      position: relative;
      height: 25%;
      width: fit-content;
      text-decoration: none;
      gap: 0.5rem;
      font-size: 10vw;

      &[data-current] {
        &::after {
          content: "*";
          position: relative;
        }
      }

    }

    @media (width >= 64rem) {
      --main-navigation-background: transparent;

      position: relative;
      top: 0;
      flex-direction: row;
      justify-content: center;
      height: 2rem;
      z-index: inherit;
      align-items: center;
      margin-left: auto;
      background-color: inherit;

      &__link {
        padding-inline: 1rem;
        height: 100%;
        font-size: 1.25rem;
      }
    }
  }
</style>

