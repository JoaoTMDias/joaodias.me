---
import { getEntry } from "astro:content";
import Logo from "../logo/index.astro";
import MainNavigation from "../navigation/main-navigation.astro";
import MobileNavigation from "../navigation/mobile-navigation.astro";
import MobileNavigationToggle from "../navigation/mobile-navigation-toggle.astro";
import SkipLink from "../skip-link";
import ThemeSwitcher from "../theme-switcher/index.astro";
import styles from "./index.module.scss";

const config = await getEntry("config", "config");
---

<header class={styles.header}>
  <SkipLink items={config?.data.skipLinks ?? []} />
  <div class={styles.header__container}>
    <Logo />
    <div class={styles.header__nav}>
      <MainNavigation />
      <ThemeSwitcher />
      <MobileNavigationToggle />
    </div>
  </div>
  <MobileNavigation />
</header>
