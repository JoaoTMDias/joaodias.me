---
import { getEntry } from "astro:content";
import Logo from "../logo/index.astro";
import MainNavigation from "../main-navigation/index.astro";
import SkipLink from "../skip-link";

const config = await getEntry("config", "config");
---

<header class="navigation">
	<SkipLink items={config.data.skipLinks} client:load />
	<button type="button" class="navigation__toggle">
		Toggle Navigation
	</button>
	<Logo />
	<MainNavigation />
</header>

<style lang="scss">
	.navigation {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		max-width: 100%;
		gap: 1rem;
		min-height: var(--header-height);
	}
</style>
