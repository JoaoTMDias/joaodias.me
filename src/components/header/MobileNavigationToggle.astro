<button
  id="mobile-navigation-toggle"
  type="button"
  class="mobile-navigation-toggle"
  popovertarget="mobile-navigation"
  popovertargetaction="toggle"
>
  <span class="mobile-navigation-toggle__open">Menu</span>
  <span class="mobile-navigation-toggle__close">Close</span>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.getElementById("mobile-navigation");
    navigation?.addEventListener("toggle", (e) => {
      document.body.style.overflow = (e as ToggleEvent).newState === "open" ? "hidden" : "";
    });
  });

  document.addEventListener("astro:before-swap", () => {
    (document.getElementById("mobile-navigation") as HTMLButtonElement)?.hidePopover();
    document.body.style.overflow = "";
  });
</script>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .mobile-navigation-toggle {
    --toggle-background-color: var(--background-color);
    --toggle-color: var(--text-color);
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: auto;
    height: var(--space-xl);
    border-radius: var(--space-xl);
    background-color: transparent;
    border: none;
    cursor: pointer;
    background-color: var(--toggle-background-color);
    color: var(--toggle-color);

    @media (--medium-viewport) {
      display: none;
    }

    @media (--with-motion) {
      transition:
        background-color 200ms ease,
        color 300ms ease;
    }

    &__open,
    &__close {
      font-family: var(--text-font-family);
      font-size: var(--font-size-base);
      font-weight: 600;
      line-height: var(--space-md);
      letter-spacing: 0.05rem;
      padding-inline: var(--space-base);
      padding-block: var(--space-sm);
    }

    &:hover,
    &:focus {
      --toggle-background-color: light-dark(var(--color-N90), var(--color-N90));
      --toggle-color: light-dark(var(--color-N10), var(--color-N90));
    }
  }

  .mobile-navigation-toggle__close {
    display: none;
  }

  :global(.header:has(#mobile-navigation:popover-open)) {
    .mobile-navigation-toggle__open {
      display: none;
    }

    .mobile-navigation-toggle__close {
      display: inline;
    }
  }
</style>
