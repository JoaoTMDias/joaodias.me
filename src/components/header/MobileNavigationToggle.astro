<button
  id="mobile-navigation-toggle"
  type="button"
  class="mobile-navigation-toggle"
  popovertarget="mobile-navigation"
  popovertargetaction="toggle"
>
  <span class="mobile-navigation-toggle__open">Menu</span>
  <span class="mobile-navigation-toggle__close">Close</span>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const navigation = document.getElementById("mobile-navigation");
    navigation?.addEventListener("toggle", (e) => {
      document.body.style.overflow = (e as ToggleEvent).newState === "open" ? "hidden" : "";
    });
  });

  document.addEventListener("astro:before-swap", () => {
    (document.getElementById("mobile-navigation") as HTMLButtonElement)?.hidePopover();
    document.body.style.overflow = "";
  });
</script>

<style lang="scss">
  @use "../../assets/styles/custom-media.scss";

  .mobile-navigation-toggle {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: auto;
    height: var(--space-md);
    background-color: transparent;
    border: none;
    cursor: pointer;
    padding-inline: var(--space-base);
    padding-block: var(--space-sm);

    @media (--medium-viewport) {
      display: none;
    }

    &__open,
    &__close {
      font-family: var(--text-font-family);
      font-size: var(--font-size-base);
      font-weight: 600;
      line-height: var(--space-md);
      letter-spacing: 0.05rem;
    }
  }

  .mobile-navigation-toggle__close {
    display: none;
  }

  :global(.header:has(#mobile-navigation:popover-open)) {
    .mobile-navigation-toggle__open {
      display: none;
    }

    .mobile-navigation-toggle__close {
      display: inline;
    }
  }
</style>
